# ─────────────────────────────────────────────────────────────────────────────
# HWAX Portal — routing destinations.   Format:  <system-id>=<URL>
#
# Set a system's URL here → its tile becomes clickable AND nginx adds /<id>/ → that URL.
# Leave it commented → the tile stays "coming_soon".
# The names/logos/descriptions live in systems.yaml; ONLY the destination is here.
#
# After editing:  ./infra/scripts/restart.sh   (or POST /systems/reload as admin)
#
# ── This file is for PROXY-mode tiles (integration_type: proxy in systems.yaml) ──────────────
# nginx reverse-proxies  <portal>/<id>/  →  the URL below, PASSING the /<id>/ prefix through.
# The URL is resolved by the NGINX HOST (not the user's browser), so:
#   same server as the portal :  heax-hub=http://localhost:4180
#   another server (by IP)    :  heax-hub=http://10.123.45.67:4180
#
# ⚠️ Because the /<id>/ prefix is passed through, the service MUST serve under that base path
#    (e.g. Vite `base: '/<id>/'`, or its own router base) or its absolute /assets/... will 404.
#    A destination WITH a path (…:8001/dashboard/) instead maps /<id>/ → /dashboard/.
#
# Services with their OWN address (own domain / externally-exposed port) do NOT belong here —
# set integration_type: external-url + url in systems.yaml; the tile links to it directly.
#
# Per-env: dev edits this file; prod uses config/routes.prod.env via ROUTES_PATH. Any single
# line can be overridden by an env var:  SYS_HEAX_HUB_URL=http://10.0.0.5:4180
# After editing:  ./infra/scripts/restart.sh   (or POST /systems/reload as admin)
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Live on this host (same server as the portal) — proxied under /<id>/.
# HEAX Hub's Caddy serves at the ROOT (/, /api, /assets); its dist is built with base /heax-hub/,
# so STRIP the prefix here (trailing slash) → /heax-hub/assets → Caddy /assets. (MX White Paper
# below uses `vite preview` which serves UNDER the base, so it does NOT get a trailing slash.)
heax-hub=http://localhost:4180/
# HEAX Hub's HOSTED APPS, at the SAME public path the apps use to reference themselves.
# Why this exists: /heax-hub/ STRIPS the prefix, so an app opened at /heax-hub/apps/<id>/ is served
# by Caddy at /apps/<id>/ and emits ROOT-ABSOLUTE self URLs ("/apps/<id>/static/x.js", Dash/Flask/Go
# and Next.js 308 Location) that drop the /heax-hub prefix. Without a /apps/ location those fall to
# the portal catch-all, which returns index.html with HTTP 200 — so the browser gets HTML where it
# expected JS and the app silently fails to boot. Only apps whose assets are RELATIVE ("./assets/…")
# survived. Routing /apps/ to Caddy's /apps/ makes those self URLs resolve for every app, with no
# per-app rebuild. Exact "/apps" (the portal's own tile page) does NOT match this prefix location.
apps=http://localhost:4180/apps/
# AI Data Hub serves UI at /dashboard and /api,/static,/downloads at its root → map /ai-data-hub/
# to the service ROOT (trailing slash strips the prefix). Its FastAPI redirects "/" → dashboard,
# and dashboard.js derives the prefix, so everything resolves under /ai-data-hub/.
ai-data-hub=http://localhost:8001/
# MX White Paper: the web container serves the prebuilt dist statically (`serve`, at root), so STRIP
# the prefix (trailing slash). Its API is a SEPARATE upstream (:8800) — a more-specific location for
# /mx-white-paper/api/ routes there (nginx longest-prefix wins). The id with a "/" just becomes a
# nested nginx location; it is not a tile (tiles come from systems.yaml).
mx-white-paper=http://localhost:5173/
mx-white-paper/api=http://localhost:8800/api/

# SignalForge — Samsung MX VOC intelligence. The frontend (vite dev now, vite preview / nginx-on-
# sif later) is built with base /signalforge/ so its assets resolve under the prefix; we PASS the
# prefix through (bare host → gen-nginx-conf will force a trailing slash; assets still resolve via
# the baked base). The FastAPI backend serves /api/v1/... at its root, so map /signalforge/api/ →
# :18000/api/ (nginx longest-prefix wins over /signalforge/). WebSocket /api/v1/alerts/stream is
# covered by the same /api/ route via the existing $connection_upgrade map in hwax.conf.
signalforge=http://127.0.0.1:17370/
signalforge/api=http://127.0.0.1:18000/api/

# report-archive — dev: proxied under /report-archive/ → combined FastAPI+SPA on :3000 (frontend
# built with base /report-archive/, API base /report-archive, DB on the neutral system PG :5433).
# The registry auto-promotes the external-url tile in systems.yaml → proxy once this route exists.
report-archive=http://127.0.0.1:3000/
# smart-twin-cluster / spdm have their own domains → external-url in systems.yaml (not here).

# Smart Twin Explorer — Slurm 해석 잡 실행 서비스. 백엔드는 이 박스가 아니라 STE 대상
# 클러스터(stc = smart_twin_cluster_26 컨트롤러 icn401-0116-h01)에 있고, 그 백엔드가 SPA 까지
# 같이 서빙한다(같은 오리진이라 CORS 가 없다). 그래서 여기서는 프록시만 하고 services.yaml 에는
# 넣지 않는다 — 포털이 이걸 start 하려 들면 안 된다.
# dist 는 base=/ste/ 로 구워져 있고 이 줄은 접두사를 STRIP 하므로(끝 슬래시) 백엔드는
# /assets/... 를 받는다. 백엔드의 strip_base 미들웨어가 직접 접속(/ste/api/...)도 같이 흡수한다.
# 인증은 백엔드가 401 JSON 으로 한다 — 포털은 SSO 리다이렉트를 걸지 않는다.
# ⚠ STE 주소는 박스마다 다르다(대상 클러스터가 다름 — stc vs 기존 대형 클러스터). base 에 두지
#   않고 routes.local.env 에서 설정한다. 오버레이가 없는 박스는 /ste/ 라우트를 아예 만들지 않아
#   안전 기본값이 된다. 아래 dev VM 값은 참고용 주석 — 필요한 박스만 routes.local.env 로 활성화한다.
#ste=http://192.168.130.10:15810/
