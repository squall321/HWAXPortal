# PaperIngest .env 블록 — 대상: <PaperIngest>/.env (없는 키만 추가됨)
# 검증 게이트 GLM 은 playbook §8 원칙대로 config/env 로 잡는다. PaperIngest 는 ReportArchive 가 이미 쓰는
# LLM 설정을 '그대로' 상속한다 — apply 시점에 형제 ReportArchive/.env 의 LLM_BASE_URL·LLM_MODEL·LLM_API_KEY 를
# 읽어 아래 마커를 치환(둘 다 OpenAI 호환 /v1).
#   · cae00(운영): RA 가 상암 프로덕션 LLM(예: http://10.198.143.137:10000/v1, model GLM-5-2)이면 그대로 상속.
#   · dev: RA 가 mock(LLM_ 미설정)이면 이 키들은 건너뜀 → glm_ready=false(게이트 비활성, 색인/그라운딩은 정상).
# 적용: bash infra/env-kits/apply-envs.sh paper-ingest  (기본 서비스 목록에 없으니 인자 명시)
GLM_BASE_URL=@FROM_RA:LLM_BASE_URL@
GLM_MODEL=@FROM_RA:LLM_MODEL@
GLM_API_KEY=@FROM_RA:LLM_API_KEY@
# 사내 프록시 박스(cae00)에서 필수: http(s)_proxy 설정 프로세스는 상암 등 내부 IP 요청도 프록시로 흘려
# Connection error 가 난다. httpx 가 존중하는 NO_PROXY 로 내부 목적지 예외 처리.
NO_PROXY=10.198.143.137,127.0.0.1,localhost
no_proxy=10.198.143.137,127.0.0.1,localhost
# --- 경로·유입 (cae00 리터럴; dev 는 대상 .env 에 직접 조정) ---
PIPELINE_DIR=/opt/expertgrounding
CORPUS_DIR=/data/paper_patent_corpus
INBOX_DIR=/data/appdata/paper_ingest/_inbox
DRIVE_REMOTE=HeaxDrive:paper-ingest/inbox
