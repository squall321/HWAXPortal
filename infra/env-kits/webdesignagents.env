# WebDesignAgents LLM 상속 .env 블록 — 대상: <WebDesignAgents>/.env (없는 키만 추가됨)
# 경로 B(vLLM 무인 심의)가 쓰는 접속값. ReportArchive 설정을 그대로 상속한다.
#
# WDA 는 LLM_* 를 RA 와 같은 이름으로 읽는다(src/wdllm/config.py) — 변환이 없다.
# 주소만 주고 모델명을 빼면 그 서버에 없는 모델을 부르게 되므로 셋을 같이 상속한다.
LLM_BASE_URL=@FROM_RA:LLM_BASE_URL@
LLM_MODEL=@FROM_RA:LLM_MODEL@
LLM_API_KEY=@FROM_RA:LLM_API_KEY@

# 사내 LLM 은 프록시를 타면 안 된다. 주소를 킷에 적지 않는다(이 리포는 공개다, 10-17 결정 1).
NO_PROXY=@NO_PROXY@
no_proxy=@NO_PROXY@

# GLM-5-2 는 스트리밍+tool_calls 조합에서 깨진다 — 비스트리밍 고정 (PLAN §10.1 5원칙 ①).
LLM_DISABLE_STREAMING=1
