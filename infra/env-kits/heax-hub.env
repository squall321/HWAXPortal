# HEAXHub 포털 SSO 연동 .env 블록 — 대상: <HEAXHub>/.env (없는 키만 추가됨)
PORTAL_JWKS_URL=http://127.0.0.1:8723/.well-known/jwks.json
PORTAL_AUDIENCE=heax-hub
PORTAL_ISSUER=https://hwax.sec.samsung.net
PORTAL_SSO_LANDING=/heax-hub/

# ── 호스팅 앱에 물려줄 LLM 설정 ──────────────────────────────────────────────
# HEAXHub 가 띄우는 앱(WebDesignAgents 무인 심의 등)은 LLM_BASE_URL/LLM_MODEL 을 읽는데,
# 컨테이너가 --cleanenv 로 떠서 명시 전달 외에는 들어갈 방법이 없다. 런처가 그 장치를
# 갖고 있으나(integration_launcher._APP_LLM_ENV) 호스트에 값이 없으면 빈손으로 돈다 —
# 그러면 앱이 자기 dev 폴백(127.0.0.1:8000)으로 떨어지고, cae00 처럼 그 주소에 아무것도
# 없는 박스에서는 Errno 111 Connection refused 로 죽는다(2026-08-19 실측).
#
# ⚠ 이름이 HEAX_APP_LLM_* 인 이유 — HEAXHub 자신도 LLM_MODEL 을 쓴다. 같은 이름을 쓰면
# 둘이 서로 덮어쓴다. 런처가 컨테이너로 넣을 때 LLM_* 로 바꿔 준다.
HEAX_APP_LLM_BASE_URL=@FROM_RA:LLM_BASE_URL@
HEAX_APP_LLM_MODEL=@FROM_RA:LLM_MODEL@
HEAX_APP_LLM_API_KEY=@FROM_RA:LLM_API_KEY@
# 사내 프록시 박스에서 필수 — 내부 IP 요청이 프록시로 나가면 되레 막힌다. 런처가 이 값을
# 앱 컨테이너로 그대로 물려준다(_PROXY_ENV).
NO_PROXY=10.198.143.137,127.0.0.1,localhost
no_proxy=10.198.143.137,127.0.0.1,localhost
