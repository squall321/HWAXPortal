# HWAX nginx — generated from this template by infra/scripts/gen-nginx-conf.sh.
# DO NOT edit hwax.conf directly (it is overwritten). Edit this template or routes.env.
# Rootless-safe: pid/logs/temp all under /tmp (the only guaranteed-writable dir).

worker_processes auto;
pid /tmp/hwax-nginx.pid;
error_log /tmp/hwax-nginx-error.log warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # 접근 로그 — "얼마나 많은 사람이 쓰는가"의 정문 기록(2026-09-02, 그전엔 off 라 정문이
    # 통째로 안 세졌다). 쿼리 스트링은 일부러 뺀다($uri) — /auth/callback?code=… 의 자격
    # 코드가 로그에 남으면 안 된다. 위치는 /workspace(레포 바인드)의 gitignore 영역이라
    # 재기동에도 남고 커밋되진 않는다. 집계는 infra/scripts/usage-report.sh.
    # 끝 칸은 로그인 연결 ID(hwax_uid 쿠키 — 자격이 아니다)다. 포털 원장의 login 행과 이어 정문 요청을 계정에 붙인다
    # (docs/access-history). 칸은 **끝에만** 더한다 — 앞 칸 위치로 읽는 집계(usage-report ①)가 그대로 돈다.
    log_format hwax_access '$remote_addr "$http_x_forwarded_for" [$time_iso8601] '
                           '"$request_method $uri" $status $body_bytes_sent '
                           '"$http_user_agent" "$cookie_hwax_uid"';
    access_log /workspace/infra/data/nginx-access.log hwax_access buffer=16k flush=5s;
    sendfile on;
    server_tokens off;

    # 업로드 상한은 http 레벨에서 한 번만 정한다 — location 마다 붙이면 새 라우트가 생길 때마다
    # 조용히 1m 로 되돌아간다. nginx 기본값 1m 은 이 포탈이 실제로 다루는 파일과 두 자릿수
    # 어긋나 있다: 시뮬레이션 K파일·메시, 물성 원본, Report Archive 의 PPT/문서 업로드,
    # 에이전트 첨부. 실측으로 /ai-data-hub/, /mx-white-paper/api/, /signalforge/api/,
    # /report-archive/, /agent/, /mcp-gw/ 가 3MB 에서 전부 413 이었다.
    # 백엔드가 아무리 크게 받아도 여기서 먼저 잘리므로 원인이 앱처럼 보인다.
    # 개별 경로는 필요하면 location 에서 더 낮추거나 스트리밍 옵션을 얹는다.
    client_max_body_size 2048m;

    client_body_temp_path /tmp/hwax-nginx-body;
    proxy_temp_path       /tmp/hwax-nginx-proxy;
    fastcgi_temp_path     /tmp/hwax-nginx-fastcgi;
    uwsgi_temp_path       /tmp/hwax-nginx-uwsgi;
    scgi_temp_path        /tmp/hwax-nginx-scgi;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # WebSocket upgrade passthrough (vite HMR / streamlit / etc. on linked services)
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Original host INCLUDING port ($http_host, unlike $host) — prefix-aware backends (HEAXHub
    # _public_base_url) read this first to rebuild public absolute URLs; without it they fall back
    # to Host/upstream and emit http://localhost:<port> links that break behind the TLS entry.
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # Plain HTTP (health / LAN). When TLS is on, the HTTPS server below is the main entry.
    server {
        listen {{HTTP_PORT}};
        server_name _;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # ── per-system path routes (generated from routes.env) ──
{{LOCATIONS}}
        # ── MCP chat SSE: the portal's only streaming endpoint ──
        # Without these, the long-lived text/event-stream gets buffered/cut: the global
        # `gzip on` chunk-buffers it, proxy_buffering(on) holds the whole body, and the
        # default proxy_read_timeout(60s) drops a quiet stream. Scoped to /agent/ so nothing
        # else changes. X-Accel-Buffering:no is also set per-response by the backend.
        # proxy_read_timeout 은 **침묵** 한도다(바이트 사이 간격 — 벽시계가 아니다). 값은 gen-nginx-conf.sh 가 infra/.env 의
        # NGINX_AGENT_READ_TIMEOUT(기본 50400s = 14시간)으로 채운다. 1h 리터럴이던 동안은 좌석 20석 넘는 심의의 LLM 호출 한 번
        # (재시도 포함 3608초)이 조용한 사이에 여기서 끊겼다 — 심의는 서버에서 계속 도는데 화면에는 'network error' 만 남았다.
        # 포털 릴레이의 침묵 한도(AGENT_STREAM_IDLE_TIMEOUT_S, 기본 46800초)보다 **커야** 한다 — 포털이 먼저 걸려야 손잡이
        # 이름이 든 문구가 화면에 간다(nginx 는 문구를 못 낸다 — error 로그의 'upstream timed out' 뿐이다).
        # proxy_connect_timeout 은 죽은 상대만 잡는 값이라 짧게 둔다(300s 는 nginx 가 실제로 쓰는 범위 약 75초 밖이었다).
        location /agent/ {
            proxy_pass http://127.0.0.1:{{PORTAL_PORT}};
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout {{AGENT_READ_TIMEOUT}};
            proxy_connect_timeout 10s;
        }
        # ── MCP gateway (streamable-http) — a personal Claude connects here with a portal PAT.
        # STRIPs /mcp-gw/ → gateway sees /mcp (which authenticates the Bearer PAT itself). Same
        # no-buffer/long-timeout streaming settings as /agent/. Keep in sync with the TLS server
        # block in gen-nginx-conf.sh.
        # ⚠ **무인증 진단 엔드포인트는 밖으로 열지 않는다.** 게이트웨이의 `/health`·
        # `/tools-map` 은 Bearer 를 안 본다(오케스트레이터가 싸게 프로브하라고 그렇게 뒀다).
        # 그런데 `/mcp-gw/` 를 통째로 프록시하면 그게 **외부 오리진에서 그대로 보인다** —
        # 실측으로 `/mcp-gw/tools-map` 이 200·43KB(도구 473종 → 앱 매핑 전체)를 냈다.
        # 인증을 지나는 `/mcp-gw/mcp` 와 `/mcp-gw/api/` 만 남긴다(6차가 `/health` 본문에서
        # 권한 지도를 뺐지만, 형제 `/tools-map` 은 그대로였다 — 7차 감사).
        location ~ ^/mcp-gw/(health|tools-map|refresh|conn-invalidate) {
            return 404;
        }
        # 침묵 한도는 NGINX_MCP_READ_TIMEOUT(기본 1h) — 게이트웨이의 도구 호출 1건 바깥 기한(660초)보다 커야 한다.
        # MCP 심의는 잡(deliberate_start → status 폴링)이라 교환 하나가 길지 않고, 게이트웨이가 15초마다 ping 을 싣는다.
        location /mcp-gw/ {
            proxy_pass http://127.0.0.1:9110/;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout {{MCP_READ_TIMEOUT}};
            proxy_connect_timeout 10s;
        }
        # ── portal (hero + API): catch-all ──
        location / {
            proxy_pass http://127.0.0.1:{{PORTAL_PORT}};
        }
    }
{{TLS_SERVER}}
}
